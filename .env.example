# ==========================================
# SiPenDosa — Sistem Pengingat Dosen Saatnya
# Configuration Environment
# ==========================================

# Server Settings
PORT=8473
HOST=0.0.0.0
APP_ENV=production

# Mode akses antarmuka: terminal (default, konsol interaktif tanpa web) |
# web (daemon + dashboard browser) | desktop (web + jendela aplikasi desktop)
#SIPEN_UI=web
# Set COOKIE_SECURE=true jika disajikan lewat HTTPS (mis. di belakang tunnel Cloudflare)
COOKIE_SECURE=false

# Database & Session Storage
DB_PATH=data/sipen.db
WA_SESSION_PATH=session/whatsapp.db

# Scheduler & Timezone Settings
DEFAULT_TIMEZONE=Asia/Makassar
SEND_WINDOW_START=08:00
SEND_WINDOW_END=16:00

# WhatsApp Anti-Ban & Rate Limiter
RATE_LIMIT_MIN_SEC=5
RATE_LIMIT_MAX_SEC=15
MAX_RETRIES=3

# Global Dry Run Mode (true = tidak mengirim WA nyata, hanya mencatat)
GLOBAL_DRY_RUN=false
